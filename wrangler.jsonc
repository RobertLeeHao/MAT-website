// MAT website on Cloudflare (v3.7): static files only — no Worker code, no database, no secrets.
// Downloads come from GitHub Releases, feedback from GitHub Discussions. Setup steps: SETUP.md
// (The old waitlist Worker is kept, unused, in archive/waitlist-worker.)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mat-website",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "single-page-application"
  }
}
